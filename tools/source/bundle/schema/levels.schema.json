{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nssharpe/gym-skill-extract/schema/levels.schema.json",
  "title": "UCG competition levels (skill_catalog/levels.json)",
  "description": "Version 0.1.0 (2026-10-18). Which codes value a skill at each UCG level, and how their element groups map to the level's. The file's own _doc explains the rules.",
  "type": "object",
  "required": ["version", "WAG", "MAG"],
  "additionalProperties": false,
  "properties": {
    "_doc": { "type": "string" },
    "_version_doc": { "type": "string" },
    "version": { "description": "Date of the last change.", "type": "string", "format": "date" },
    "WAG": { "$ref": "#/$defs/levels" },
    "MAG": { "$ref": "#/$defs/levels" }
  },
  "$defs": {
    "levels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "planner_id", "value_codes", "eg"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "planner_id": { "type": "string" },
          "value_codes": {
            "description": "Code keys in priority order: the first with a record for the element values it.",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z]+(-[A-Z0-9]+)+$" }
          },
          "eg": {
            "type": "object",
            "required": ["from"],
            "additionalProperties": false,
            "properties": {
              "from": { "enum": ["WG", "USAG", "code"] },
              "map": {
                "description": "Apparatus -> source group -> level group.",
                "type": "object",
                "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
              },
              "condensed": {
                "description": "Apparatus -> level group -> source groups.",
                "type": "object",
                "additionalProperties": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
              },
              "note": { "type": "string" }
            }
          },
          "values": {
            "description": "Value letter -> points at this level, where the level does not use the code's own.",
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
